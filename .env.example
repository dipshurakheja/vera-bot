# ---- server ----
PORT=8080
LOG_LEVEL=INFO

# ---- /v1/metadata ----
TEAM_NAME=Team Vera
TEAM_MEMBERS=Your Name
CONTACT_EMAIL=team@example.com
BOT_VERSION=1.0.0
SUBMITTED_AT=2026-09-25T00:00:00Z

# ---- optional LLM polish (deterministic composer is always the source of truth) ----
# LLM_PROVIDER: anthropic | openai | groq | deepseek | openrouter | ollama | openai_compatible   (empty = off)
LLM_PROVIDER=
LLM_API_KEY=
# LLM_MODEL (alias: MODEL). Defaults: anthropic -> claude-opus-5, openai -> gpt-4o-mini
LLM_MODEL=
LLM_BASE_URL=
# off | polish   (defaults to polish when a provider + key are set)
VERA_LLM_MODE=
LLM_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=1
VERA_TICK_LLM_BUDGET_SECONDS=18

# ---- engine policy ----
VERA_MAX_ACTIONS_PER_TICK=20
VERA_MAX_CONTEXT_BYTES=524288
VERA_ENFORCE_TRIGGER_EXPIRY=false
VERA_OPT_OUT_DAYS=30
# defer non-urgent merchant triggers while another merchant conversation is active (0 = off)
VERA_MERCHANT_COOLDOWN_MINUTES=30

# ---- judge simulator runner (scripts/run_judge.py) ----
BOT_URL=http://localhost:8080
JUDGE_LLM_PROVIDER=
JUDGE_LLM_API_KEY=
JUDGE_LLM_MODEL=
TEST_SCENARIO=all
