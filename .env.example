# Copy to .env and fill in the judge key. Never commit .env.
# Every other setting has a safe default in code (see README, "Environment variables").

# ---- server ----
PORT=8080
LOG_LEVEL=INFO

# ---- /v1/metadata ----
TEAM_NAME=Dipshu Vera
TEAM_MEMBERS=Dipshu Rakheja
CONTACT_EMAIL=dipshu.rakheja.ug23@nsut.ac.in
BOT_VERSION=1.0.0
SUBMITTED_AT=2026-09-26T00:00:00Z

# ---- engine ----
# defer non-urgent merchant triggers while another merchant conversation is active (0 = off)
VERA_MERCHANT_COOLDOWN_MINUTES=30

# ---- local judge (scripts/run_judge.py, scripts/score_pairs.py) ----
BOT_URL=http://localhost:8080
JUDGE_LLM_PROVIDER=groq
JUDGE_LLM_API_KEY=
JUDGE_LLM_MODEL=openai/gpt-oss-120b
JUDGE_MIN_INTERVAL=10
JUDGE_RETRIES=4
TEST_SCENARIO=all
